{
  "name": "slop-radar",
  "version": "1.1.0",
  "description": "Find AI slop in English and German text: 600+ buzzwords, 16 structural patterns and a 0-100 score. CLI, Node.js library, browser demo and Claude Code skill.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "slop-radar": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "build:demo": "npm run build && node scripts/build-demo.mjs",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "check": "node dist/cli.js check",
    "test": "npm run build && npm run test:unit && npm run test:regression",
    "test:unit": "node --test test/unit/*.test.mjs",
    "test:regression": "bash test/regression/cli-args.test.sh",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ai",
    "slop",
    "detection",
    "writing",
    "quality",
    "buzzword",
    "llm",
    "ai-detection",
    "content-quality",
    "german",
    "cli",
    "linter",
    "writing-assistant",
    "llm-detection"
  ],
  "author": "renefichtmueller",
  "contributors": [
    {
      "name": "Terry Sweetser",
      "url": "https://github.com/tcsweetser"
    }
  ],
  "license": "MIT",
  "homepage": "https://github.com/renefichtmueller/slop-radar#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/renefichtmueller/slop-radar.git"
  },
  "bugs": {
    "url": "https://github.com/renefichtmueller/slop-radar/issues"
  },
  "files": [
    "dist",
    "src/database"
  ],
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/node": "^22.0.0"
  }
}
